{
  "name": "terraform",
  "image": "ghcr.io/jay-withers/dev-containers/terraform:latest@sha256:8e87e2bcd204d581c293160884af06148518b37d787cf6a558bb7cb904a6d362",
  "mounts": [
    "source=${localEnv:HOME}/Git,target=/Users/jay/Git,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  // `make demo` publishes three ports and VS Code will offer to open whichever
  // it notices first — which is how you end up looking at the API's bare
  // {"detail":"Not Found"} instead of the dashboard. The API has no route at
  // "/" by design: it serves /api/*, /healthz, /readyz and /docs only.
  "forwardPorts": [8080, 8000, 5432],
  "portsAttributes": {
    "8080": { "label": "MarketAgent dashboard", "onAutoForward": "openBrowser" },
    "8000": { "label": "MarketAgent API (no page at /, try /docs)", "onAutoForward": "silent" },
    "5432": { "label": "Postgres", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make install",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-setup"
}

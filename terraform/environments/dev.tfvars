environment = "dev"

# The PostgreSQL administrator defaults to whoever runs `terraform apply`. Set these to
# name a specific principal instead — an Entra group is the tidiest choice,
# since it keeps administrator access working no matter who (or what) applies:
#
# postgres_admin_object_id      = "00000000-0000-0000-0000-000000000000"
# postgres_admin_principal_name = "marketagent-dev-db-admins"
# postgres_admin_principal_type = "Group"

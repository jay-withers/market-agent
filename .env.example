# Copy to .env and fill in. Never commit .env — .gitignore covers it, and
# gitleaks scans as a backstop.
#
# settings.secret() reads the underscored, uppercased name from the environment
# first and only then falls back to Key Vault by the hyphenated name, so these
# are what make `docker compose up` work with no Azure at all.

DEEPSEEK_API_KEY=
# One credential pair per paper account — static-100 and dynamic-500 are
# separate Alpaca accounts and need separate keys. See alpaca_api.py's
# use_account() for how a process picks which pair it reads.
ALPACA_API_KEY_STATIC100=
ALPACA_SECRET_KEY_STATIC100=
ALPACA_API_KEY_DYNAMIC500=
ALPACA_SECRET_KEY_DYNAMIC500=
RESEND_API_KEY=

# You probably do not need the six above. `make run-agent` reads them from Key
# Vault instead, by minting a short-lived token from your `az login` and passing
# it to the container — nothing long-lived on disk. This file is for having no
# Azure access at all, or for preferring a file.
#
# Running from the dev container rather than a container needs only this:
# KEY_VAULT_URI=https://kv-marketagent-dev.vault.azure.net/

# Paper trading is the default. Set true to simulate fills without submitting
# orders to Alpaca.
DRY_RUN=false

# Where the daily summary is emailed. Empty means compose and store it but send
# nothing. In a deployed environment this comes from Key Vault instead — the
# recipient is not in Terraform, because this repository is public.
SUMMARY_EMAIL_TO=

# Risk limits, all optional — see risklimits.py for the defaults.
# RISK_MAX_TRADE_USD=10000
# RISK_MAX_DAILY_TRADES=3

# Application Insights. Empty — the default — disables telemetry entirely, which
# is what keeps a local run offline; Terraform injects the real one in Azure.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
